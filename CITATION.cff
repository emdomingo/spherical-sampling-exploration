    family-names: "Domingo"
version: 1.0.0
date-released: "2026-10-05"
license: MIT
repository-code: "https://github.com/emdomingo/spherical-sampling-exploration"
keywords:
  - spherical harmonics
  - spherical sampling
  - spherical Fourier transform
  - quadrature on the sphere
  - bandlimited signals
  - polyhedral grids
  - reconstruction error
